{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "딸깍악보",
  "version": "0.1.0",
  "identifier": "com.mobinogi.mmlconverter",
  "mainBinaryName": "ttalkkak-akbo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "딸깍악보",
        "width": 1000,
        "height": 700,
        "minWidth": 350,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "dragDropEnabled": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2QUVFRjMyNzk0MzMxOEYKUldTUE1VTjVNdSt1dHBVQzdaVllTSU5ybGlXVG5XdC8rcFkxRmJiQkxKMHUrQmRmcy8rUm0yazAK",
      "endpoints": [
        "https://github.com/molla2025/m2mm/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
